APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false

APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr
APP_FAKER_LOCALE=hr_HR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Za produkciju iza reverse proxyja (nginx, Cloudflare): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# Obavezni 2FA za super-admine (postavi false u lokalnom .env za lakši dev)
REQUIRE_SUPER_ADMIN_2FA=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Produkcija: pokreni queue worker (Supervisor ili schedule:run svake minute)
# php artisan queue:work --tries=3

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SaaS API sinkronizacija (udruga-saas na portu 8000)
UDRUGA_SAAS_API_URL=http://127.0.0.1:8000
UDRUGA_SAAS_API_KEY=

# SMB modul (port 8002)
SMB_SAAS_API_URL=http://127.0.0.1:8002
SMB_SAAS_API_KEY=

SAAS_HTTP_VERIFY=true
SAAS_HTTP_RESOLVE_LOOPBACK=false

SAAS_WEBHOOK_SECRET=

# Core platform identity (Faza B)
PLATFORM_TOKEN_TTL_HOURS=720

# Google OAuth (Faza D)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Microsoft OAuth (Faza D)
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

# GDPR (Faza D)
GDPR_MAX_EXPORTS_PER_HOUR=3
GDPR_ERASURE_GRACE_PERIOD_DAYS=14

# Stripe billing (Faza C — fallback ako nisu u postavkama konzole)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=eur
BILLING_DUNNING_SUSPEND_DAYS=14
BILLING_DUNNING_DOWNGRADE=true
BILLING_PRORATION_BEHAVIOR=create_prorations
BILLING_BANK_TRANSFER_ENABLED=true
BILLING_BANK_IBAN=
BILLING_BANK_RECIPIENT="Udruga SaaS d.o.o."
BILLING_BANK_PAYMENT_DAYS=14

# Produkcija
# APP_ENV=production
# APP_DEBUG=false
# APP_FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# TRUSTED_PROXIES=*
