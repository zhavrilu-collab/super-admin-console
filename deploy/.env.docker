# Putanje do aplikacija (relativno od deploy/ mape)
ADMIN_APP_PATH=..
SAAS_APP_PATH=../../udruga-siletici/udruga-saas

# MySQL (udruga-saas)
MYSQL_DATABASE=udruga_saas
MYSQL_USER=udruga
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Zajednički ključevi (isti u oba .env)
SYNC_API_KEY=dev-sync-key-change-me
WEBHOOK_SECRET=dev-sync-key-change-me

# Host portovi (lokalni Docker)
ADMIN_HTTP_PORT=8001
SAAS_HTTP_PORT=8000
